# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC. Keep it out of the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenRouter ----
# https://openrouter.ai/keys  — server-only, never exposed to the client
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: shown to OpenRouter for leaderboard attribution (safe to leave blank)
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Cold Outreach Generator

# ---- RocketReach (recipient email lookup) ----
# https://rocketreach.co account settings -> API. Server-only.
# When set, "Auto-fill recipients" pulls verified emails for the founders/execs
# it finds. Leave blank to just get names (emails stay empty).
ROCKETREACH_API_KEY=

# Optional: model used for founder/exec name extraction (defaults to Claude
# Haiku). Any OpenRouter model slug. Runs separately from the generation model.
FOUNDER_MODEL=anthropic/claude-haiku-4.5
